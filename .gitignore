# Common ignore patterns for hello repository

# Node / JS
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# OS generated
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# C build output
# ---------------------------------------------------------------------------
*.o
*.a
*.so
*.lo
*.la
.libs/
.deps/
.dirstamp
hello-1.0.0/hello

# ---------------------------------------------------------------------------
# Rust build output
# ---------------------------------------------------------------------------
target/
hello-1.0.0/hello-rust/target/
hello-1.0.0/hello-rust/Cargo.lock

# ---------------------------------------------------------------------------
# Autotools generated files
# ---------------------------------------------------------------------------
Makefile
Makefile.in
aclocal.m4
autom4te.cache/
config.h.in
config.status
config.cache
configure
configure~
stamp-h1

# Auxiliary scripts copied in by automake --add-missing
compile
depcomp
install-sh
missing
test-driver
ylwrap

# Release tarballs
*.tar.xz
*.tar.gz
*.tar.bz2

# Scratch directory produced by ci/build.sh
/build/

# ---------------------------------------------------------------------------
# Debian build output
# ---------------------------------------------------------------------------
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/hello/
debian/*.substvars
debian/*.debhelper.log
*.deb
*.ddeb
*.buildinfo
*.changes

# ---------------------------------------------------------------------------
# RPM build output
# ---------------------------------------------------------------------------
rpm/BUILD/
rpm/BUILDROOT/
rpm/RPMS/
rpm/SOURCES/
rpm/SRPMS/
hello-1.0.0/rpm/BUILD/
hello-1.0.0/rpm/BUILDROOT/
hello-1.0.0/rpm/RPMS/
hello-1.0.0/rpm/SOURCES/
hello-1.0.0/rpm/SRPMS/

# ---------------------------------------------------------------------------
# Flatpak build output
# ---------------------------------------------------------------------------
hello-1.0.0/flatpak/.flatpak-builder/
hello-1.0.0/flatpak/build-dir/
hello-1.0.0/flatpak/repo/
hello-1.0.0/flatpak/dist/
*.flatpak

# Aider history
.aider*
